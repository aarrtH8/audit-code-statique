{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AuditCodeStatique",
          "informationUri": "https://aarrth8.github.io/audit-code-statique/",
          "version": "1.0.0",
          "rules": [
            {
              "id": "secret-en-dur",
              "name": "secret_en_dur",
              "shortDescription": {
                "text": "Secret probable en dur"
              },
              "fullDescription": {
                "text": "Une valeur ressemblant à un secret est écrite dans le code source."
              },
              "helpUri": "https://aarrth8.github.io/audit-code-statique/rapports/",
              "help": {
                "text": "Révoquer la clé exposée, la déplacer dans une variable d'environnement, purger l'historique Git (git filter-repo)."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.1",
                "tags": [
                  "security",
                  "audit-statique"
                ]
              }
            },
            {
              "id": "cle-aws",
              "name": "cle_aws",
              "shortDescription": {
                "text": "Identifiant d'accès AWS en dur"
              },
              "fullDescription": {
                "text": "Un identifiant de clé d'accès AWS (AKIA…) figure dans le code."
              },
              "helpUri": "https://aarrth8.github.io/audit-code-statique/rapports/",
              "help": {
                "text": "Révoquer immédiatement dans IAM, examiner CloudTrail pour tout usage non autorisé, utiliser des rôles IAM."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.4",
                "tags": [
                  "security",
                  "audit-statique"
                ]
              }
            },
            {
              "id": "injection-commande",
              "name": "injection_commande",
              "shortDescription": {
                "text": "Commande système construite par concaténation"
              },
              "fullDescription": {
                "text": "Une commande est assemblée par concaténation ou interpolation avant exécution."
              },
              "helpUri": "https://aarrth8.github.io/audit-code-statique/rapports/",
              "help": {
                "text": "Passer les arguments sous forme de tableau (execFile style) et refuser toute valeur non validée."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.0",
                "tags": [
                  "security",
                  "audit-statique"
                ]
              }
            },
            {
              "id": "execution-dynamique",
              "name": "execution_dynamique",
              "shortDescription": {
                "text": "Exécution dynamique de code"
              },
              "fullDescription": {
                "text": "eval ou new Function exécute du code construit à l'exécution."
              },
              "helpUri": "https://aarrth8.github.io/audit-code-statique/rapports/",
              "help": {
                "text": "Remplacer par un analyseur ou une table de correspondance explicite."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.2",
                "tags": [
                  "security",
                  "audit-statique"
                ]
              }
            },
            {
              "id": "requete-sql-concat",
              "name": "requete_sql_concat",
              "shortDescription": {
                "text": "Requête SQL construite par concaténation"
              },
              "fullDescription": {
                "text": "Une requête SQL est assemblée avec des valeurs non paramétrées."
              },
              "helpUri": "https://aarrth8.github.io/audit-code-statique/rapports/",
              "help": {
                "text": "Utiliser des requêtes préparées / des paramètres liés (placeholder + tableau de valeurs)."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.5",
                "tags": [
                  "security",
                  "audit-statique"
                ]
              }
            },
            {
              "id": "cors-ouvert",
              "name": "cors_ouvert",
              "shortDescription": {
                "text": "CORS ouvert à toutes les origines"
              },
              "fullDescription": {
                "text": "L'en-tête autorise n'importe quelle origine."
              },
              "helpUri": "https://aarrth8.github.io/audit-code-statique/rapports/",
              "help": {
                "text": "Restreindre aux origines réellement utilisées."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "6.1",
                "tags": [
                  "security",
                  "audit-statique"
                ]
              }
            },
            {
              "id": "http-clair",
              "name": "http_clair",
              "shortDescription": {
                "text": "URL HTTP non chiffrée"
              },
              "fullDescription": {
                "text": "Une ressource est appelée en HTTP, donc sans chiffrement."
              },
              "helpUri": "https://aarrth8.github.io/audit-code-statique/rapports/",
              "help": {
                "text": "Basculer en HTTPS et vérifier les redirections."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.3",
                "tags": [
                  "security",
                  "audit-statique"
                ]
              }
            },
            {
              "id": "html-direct",
              "name": "html_direct",
              "shortDescription": {
                "text": "Écriture HTML directe"
              },
              "fullDescription": {
                "text": "innerHTML ou document.write insère une chaîne dans le DOM."
              },
              "helpUri": "https://aarrth8.github.io/audit-code-statique/rapports/",
              "help": {
                "text": "Utiliser textContent, ou assainir la valeur avec une bibliothèque dédiée."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.8",
                "tags": [
                  "security",
                  "audit-statique"
                ]
              }
            },
            {
              "id": "hachage-faible",
              "name": "hachage_faible",
              "shortDescription": {
                "text": "Algorithme de hachage faible"
              },
              "fullDescription": {
                "text": "MD5 ou SHA-1 employé pour un mot de passe ou une intégrité."
              },
              "helpUri": "https://aarrth8.github.io/audit-code-statique/rapports/",
              "help": {
                "text": "Utiliser bcrypt, scrypt ou Argon2id pour les mots de passe."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "6.5",
                "tags": [
                  "security",
                  "audit-statique"
                ]
              }
            },
            {
              "id": "tls-desactive",
              "name": "tls_desactive",
              "shortDescription": {
                "text": "Vérification TLS désactivée"
              },
              "fullDescription": {
                "text": "La vérification du certificat du pair est désactivée."
              },
              "helpUri": "https://aarrth8.github.io/audit-code-statique/rapports/",
              "help": {
                "text": "Réactiver la vérification ; installer la chaîne d'autorités correcte."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "7.0",
                "tags": [
                  "security",
                  "audit-statique"
                ]
              }
            }
          ]
        }
      },
